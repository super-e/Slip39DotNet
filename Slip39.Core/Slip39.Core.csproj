<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wordlist.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the wordlist verification can be tested against lists that are wrong. It only ever
         sees the embedded resource in production, which is by construction correct. -->
    <InternalsVisibleTo Include="Slip39.Core.Tests" />
  </ItemGroup>

</Project>
